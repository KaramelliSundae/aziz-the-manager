// Aziz may start and stop the local model and offload jobs, and nothing else.
polkit.addRule(function (action, subject) {
  if (action.id === "org.freedesktop.systemd1.manage-units" &&
      subject.user === "aziz" &&
      /^(ai-ders-llm|offload-job@[a-z0-9-]+|offload-gpu-job@[a-z0-9-]+)\.service$/.test(action.lookup("unit")) &&
      (action.lookup("verb") === "start" || action.lookup("verb") === "stop")) {
    return polkit.Result.YES;
  }
});
